%% Job Application Agent — live LangGraph workflow
%% Source of truth: app.py, nodes.py, utilities/routing.py
%% Paste this entire file into Excalidraw's Mermaid importer.
flowchart TB
    start([START]) --> initialize[initialize_user_data]
    initialize --> collect[collect_user_request]
    collect --> understand{understand_user_request_node}

    subgraph intake[Conversation and request routing]
        direction TB
        understand -->|CHAT| collect
        understand -->|APPLY_FOR_JOBS| dispatch{dispatch_job}
        understand -->|END| finish([END])
    end

    subgraph application[Queued-job application workflow]
        direction TB
        dispatch -->|job_url present| validation_context[is_job_valid]
        dispatch -->|job_url absent| collect
        validation_context --> validate{is_job_valid}

        validate -->|ELIGIBLE| details[extract_job_details]
        validate -->|NOT_ELIGIBLE| persist[update_job_status]
        details --> save[save_job_to_workbook]
        save --> resume[customize_resume]
        resume --> resolve{resolve_application_url}

        resolve -->|SUCCESS| submit{submit_job_application}
        resolve -->|FAILED| review[human_in_the_loop]

        submit -->|APPLIED| verification_context[verify_job_status]
        submit -->|NOT_APPLIED| persist

        verification_context --> verify{verify_job_status}
        verify -->|APPLIED| persist
        verify -->|NOT_APPLIED| persist
        verify -->|FAILED| verify

        persist -->|application_queue not empty| dispatch
        persist -->|application_queue empty| collect
    end

    subgraph recovery[Shared browser tools, login, and human intervention]
        direction TB
        tools[tool_node]
        login{perform_login}

        understand -->|NEEDS_TOOLS| tools
        validate -->|NEEDS_TOOLS| tools
        resolve -->|NEEDS_TOOLS| tools
        login -->|NEEDS_TOOLS| tools
        submit -->|NEEDS_TOOLS| tools
        verify -->|NEEDS_TOOLS| tools

        tools -->|tool_call_origin| understand
        tools -->|tool_call_origin| validate
        tools -->|tool_call_origin| resolve
        tools -->|tool_call_origin| login
        tools -->|tool_call_origin| submit
        tools -->|tool_call_origin| verify

        resolve -->|REQUIRES_LOGIN| login
        submit -->|REQUIRES_LOGIN| login
        login -->|SUCCESS: login_return_node| resolve
        login -->|SUCCESS: login_return_node| submit
        login -->|REQUIRES_HUMAN| review
        login -->|FAILED, no human intervention| persist

        review -->|next_step: resolve_application_url| resolve
        review -->|next_step: perform_login| login
        review -->|next_step: submit_job_application| submit
        review -->|next_step: update_job_status| persist

        submit -->|REQUIRES_HUMAN| review
    end
