%% Main LangGraph workflow. Import separately from agent-tool-resume.mmd.
flowchart LR
    start([START]) --> initialize[initialize_user_data]
    initialize --> collect[collect_user_request]
    collect --> request{understand_user_request_node}

    request -->|CHAT| collect
    request -->|FETCH_JOBRIGHT_JOBS| jobright[fetch_jobright_jobs]
    request -->|APPLY_FOR_JOBS| dispatch{dispatch_job}
    request -->|END| finish([END])

    jobright -->|collect another job| jobright
    jobright -->|collection complete| collect

    dispatch -->|job URL selected| validation_context[build_validation_messages]
    dispatch -->|queue empty| collect

    subgraph preparation[Current-job preparation]
        direction TB
        validation_context --> valid{is_job_valid}
        valid -->|ELIGIBLE| extract[extract_job_details]
        valid -->|NOT_ELIGIBLE| status[update_job_status]
        extract --> save[save_job_to_workbook]
        save --> customize[customize_resume]
        customize --> resolve{resolve_application_url}
        resolve -->|SUCCESS| apply{submit_job_application}
    end

    subgraph completion[Application completion]
        direction TB
        apply -->|APPLIED| verify_context[build_verify_job_status_messages]
        verify_context --> verify{verify_job_status}
        verify -->|APPLIED| status
        verify -->|NOT_APPLIED| status
        verify -->|FAILED: retry| verify
    end

    status -->|more queued jobs| dispatch
    status -->|queue empty| collect

    tool_note["Tool, login, and human-review paths: agent-tool-resume.mmd"]
